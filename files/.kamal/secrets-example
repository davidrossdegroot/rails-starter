# Kamal reads secrets from this file during deployment
# Copy this to .kamal/secrets and fill in your actual values
# NEVER commit .kamal/secrets to git (it's in .gitignore)

# Docker Registry
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME

# Rails
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Email (MailerSend SMTP)
MAILERSEND_SMTP_USERNAME=$MAILERSEND_SMTP_USERNAME
MAILERSEND_SMTP_PASSWORD=$MAILERSEND_SMTP_PASSWORD

# Monitoring (Sentry)
SENTRY_DSN=$SENTRY_DSN

# Analytics (Google Analytics)
GOOGLE_ANALYTICS_ID=$GOOGLE_ANALYTICS_ID
